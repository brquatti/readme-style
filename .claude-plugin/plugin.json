{
  "name": "readme-style",
  "version": "0.1.0",
  "description": "Gera e mantém README.md num padrão visual consistente (header centralizado, badges reais, sumário, seções com emoji) em qualquer projeto.",
  "author": {
    "name": "Bruno Quatti"
  },
  "license": "MIT",
  "keywords": ["readme", "docs", "documentation"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/check-readme.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
